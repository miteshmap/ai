{
  "mcpServers": {
    "context7": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--servers=context7"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
