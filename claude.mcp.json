{
"mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--servers=context7"
      ]
    }
  }
}
